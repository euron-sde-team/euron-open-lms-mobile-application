# Euron Open LMS Mobile: build-time settings (read by react-native-config).
# Copy to .env. The server is euron-open-lms: run `make up && make demo` there first.
#
# Local stack: the iOS simulator reaches your Mac's localhost directly. For the Android
# emulator or a USB device, run `pnpm android:reverse` so localhost works there too.
# On a physical device over Wi-Fi, use your Mac's LAN address instead of localhost.

# The euron-open-lms API, including /api.
API_BASE_URL=http://localhost:5026/api
# The academy's website (public certificate pages, the iOS "continue on the web" link).
WEB_BASE_URL=http://localhost:3530
# URL scheme for deep links and payment returns. Must match ios/OpenLms/Info.plist and
# android/app/src/main/AndroidManifest.xml (scripts/rename-app.sh changes all three).
APP_SCHEME=openlms
# Optional: the academy's domain for universal links / Android App Links (no scheme).
APP_LINK_HOST=
# Debug builds only: set to off so screenshots and recordings of paid video work (QA,
# documentation). Release builds ignore it and always protect paid video.
CAPTURE_GUARD=
